rules_version = '2';

// Paste into Firebase Console -> Firestore Database -> Rules, then Publish.
// Only accounts with a verified email get in.
// Each user may only read and write their own users/{uid} document,
// and only within 30 minutes of signing in (same as the website's session timer).
// You (the owner) still see every user in the Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified email (clicked the link, or Google sign-in),
    // and the sign-in happened less than 30 minutes ago.
    function activeSession() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(30, 'm');
    }

    match /users/{uid} {
      allow read: if activeSession() && request.auth.uid == uid;

      allow create, update: if activeSession()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'name', 'photoURL', 'provider', 'createdAt', 'lastSeenAt']);

      allow delete: if false;
    }

    // Shared daily counter of Google map loads: mapsQuota/{YYYYMMDD} = { count }.
    // Only today's document (Thailand time) can be written, only +1 at a time, and never above 300.
    // Keep 300 the same as GOOGLE_MAPS_DAILY_LIMIT in src/mapsQuota.js.
    function thaiToday() {
      let t = request.time + duration.value(7, 'h');
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }

    match /mapsQuota/{day} {
      allow read: if activeSession();

      allow create: if activeSession()
        && day == thaiToday()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;

      allow update: if activeSession()
        && day == thaiToday()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 300;

      allow delete: if false;
    }

    // How each Telegram alert on the Notifications page was handled: notifActions/{message_id}.
    // Shared by the whole team: any signed-in user can read and set it, but only as themselves.
    // No deletes: putting an alert back to "new" is a write with status 'new'.
    match /notifActions/{id} {
      allow read: if activeSession();

      allow create, update: if activeSession()
        && id.matches('^[A-Za-z0-9_-]{1,100}$')
        && request.resource.data.keys().hasOnly(['status', 'note', 'alarmAt', 'by', 'byName', 'at'])
        && request.resource.data.status in ['new', 'ack', 'done', 'false']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.alarmAt is timestamp
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string
        && request.resource.data.byName.size() <= 100
        && request.resource.data.at == request.time;

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
